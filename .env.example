# SciGraph optional runtime configuration (non-secret defaults)
# Copy to .env if overriding defaults locally. Never commit secrets or API keys.

# Bind host for the local SciGraph HTTP server
SCIGRAPH_HOST=127.0.0.1

# Bind port for the local SciGraph HTTP server
SCIGRAPH_PORT=8765

# Default tenant organization identifier for workspace scoping
SCIGRAPH_DEFAULT_ORG=default-org

# Root directory for isolated tenant workspaces
SCIGRAPH_WORKSPACE_ROOT=.workspaces

# Path to the optional SciGraph TOML configuration file
SCIGRAPH_CONFIG=scigraph.toml
